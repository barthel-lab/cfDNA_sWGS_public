library(XenofilteR)
library(BiocParallel)
base_path = "/scratch/smankame/matrix/"
df <- read.delim(
  "/tgen_labs/barthel/projects/GBM_Cell_Culture/scripts/cc_targeted_data_table.txt",
  sep = "\t",
  stringsAsFactors = FALSE
)
df
align_base <- file.path(
  base_path,
  "Murine/xenofilteR/align"
)
out_base <- file.path(
  base_path,
  "Murine/xenofilteR/output"
)
samples <- df %>%
  filter(
    Study == "Murine",
    !is.na(Sample),
    Sample != ""
  )
library(dplyr
library(dplyr)
install.packages("dplyr")
library(dplyr)
samples <- df %>%
  filter(
    Study == "Murine",
    !is.na(Sample),
    Sample != ""
  )
samples
for (i in seq_len(nrow(samples))) {

  patient_id <- samples$Patient[i]
  sample_id  <- samples$Sample[i]

  human_bam <- file.path(
    align_base,
    patient_id,
    paste0(sample_id, "_hg38_sorted.bam")
  )

  mouse_bam <- file.path(
    align_base,
    patient_id,
    paste0(sample_id, "_mm10_sorted.bam")
  )

  outdir <- file.path(
    out_base,
    patient_id,
    sample_id
  )
q()
